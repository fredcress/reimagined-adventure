# Copy to .env and fill in. Any service left blank is shown as "Not configured".

# Preview the screen with fake data, no keys needed. Set to 0 once configured.
DEMO=1
TZ=Europe/London

# --- Octopus Energy
# API key: https://octopus.energy/dashboard/new/accounts/personal-details/api-access
# Account number looks like A-XXXXXXXX
OCTOPUS_API_KEY=
OCTOPUS_ACCOUNT=
# Optional: only needed if the account has more than one import meter
OCTOPUS_MPAN=
OCTOPUS_SERIAL=
# Optional: API host. Octopus also serves it at https://api.oegb-kraken.energy
OCTOPUS_API_URL=

# --- Seerr / Jellyseerr / Overseerr (Settings > General > API Key), e.g. http://192.168.1.10:5055
SEERR_URL=
SEERR_API_KEY=

# Allow searching and requesting new films/series from the kitchen screen.
# Requests made with the API key are usually auto-approved (admin).
SEERR_ALLOW_REQUESTS=1
# Optional: make requests on behalf of this Seerr user id instead of the admin
SEERR_REQUEST_USER_ID=

# --- Weather (Open-Meteo, free, no key): your home's coordinates
LATITUDE=
LONGITUDE=

# --- TrueNAS health chip. Must be https:// (TrueNAS revokes keys sent over http).
# API key: TrueNAS UI > top-right user menu > My API Keys. A user with the read-only admin role is enough.
TRUENAS_URL=
TRUENAS_API_KEY=
# The NAS usually has a self-signed certificate; set to 1 if yours is a real one
TRUENAS_VERIFY_SSL=0

# --- ntfy push notifications (self-hosted, or https://ntfy.sh with a hard-to-guess topic)
NTFY_URL=
NTFY_TOPIC=
# Only needed if your ntfy server requires login (access token tk_...)
NTFY_TOKEN=
# What to push
NTFY_PRICES=1
NTFY_TIMERS=1
NTFY_NAS=1

# --- Display
# p/kWh thresholds: below CHEAP is green, at/above EXPENSIVE is red
PRICE_CHEAP=15
PRICE_EXPENSIVE=25
# Hours: cheapest upcoming windows shown on the home screen
CHEAPEST_WINDOWS=1,3
# Days shown in the home-screen usage chart
USAGE_DAYS=7
# Appliance headline: "<name>=<cycle length H:MM>[@<kWh per cycle>]", comma separated.
# The kWh is optional; with it the screen also shows the saving in pence.
# Programs of one machine share the first word (Dishwasher eco, Dishwasher quick):
# the home screen shows only the better one (cheapest run if kWh are given, else lowest avg price).
# Add ' finish' after a machine whose timer sets the END time ("Finish in 8h", Siemens washers):
#   "Clothes 40 + dry=5:15@3.5 finish"
APPLIANCES="Dishwasher eco=4:30,Dishwasher quick=2:30"
# Hours per press of the appliance's delay-start button (most dishwashers: 1)
APPLIANCE_DELAY_STEP=1
# Quick labels on the Timers screen
TIMER_LABELS="Pasta,Rice,Eggs,Oven,Tea"
# Overnight the screen shows a dim clock (tap to wake). Leave blank to disable.
NIGHT_START=23:00
NIGHT_END=06:30
# 1 = actually switch the screen off overnight (needs kiosk-display on the Pi);
# 0 = just show the dim clock. Touch wakes it either way.
SCREEN_OFF_AT_NIGHT=0
